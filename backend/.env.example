# Groq Cloud API configuration for AI symptom understanding (Backend only)
# Never expose GROQ_API_KEY to the frontend or git
GROQ_API_KEY=your_actual_groq_api_key_here

# Groq model ID
# Recommended supported models for JSON object mode and chat completions:
# - llama-3.3-70b-versatile (Recommended: best reasoning & JSON structure quality)
# - llama-3.1-8b-instant (Fastest, low latency)
# Note: Groq native model IDs do NOT use provider prefixes (e.g., avoid 'openai/gpt-oss-120b').
GROQ_MODEL=llama-3.3-70b-versatile

# Optional ML artifacts directory override
# MODEL_ARTIFACTS_DIR=

# Optional CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
